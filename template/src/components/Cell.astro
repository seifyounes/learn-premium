---
/** One title-block cell: the printed field label on top, the value below. */
interface Props {
  label: string;
  class?: string;
}
const { label, class: className = "" } = Astro.props;
---

<div class:list={["flex flex-col justify-between gap-2 bg-sheet px-3 pbs-[7px] pbe-[9px] text-pencil", className]}>
  <span class="field-label">{label}</span>
  <slot />
</div>
