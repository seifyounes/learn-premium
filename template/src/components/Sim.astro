---
import { getEntry } from "astro:content";
import { existsSync, readFileSync } from "node:fs";
import { join } from "node:path";
import { prose, type SimRef } from "../content/course";
import ControlSim from "../islands/ControlSim";
import GradientDescentSim from "../islands/GradientDescentSim";
import LadderSim from "../islands/LadderSim";
import LogicSim from "../islands/LogicSim";
import PlaneWallSim from "../islands/PlaneWallSim";
import SclSim from "../islands/SclSim";
import StepThrough from "../islands/StepThrough";
import StlSim from "../islands/StlSim";
import { buildContentDir } from "../content/layout";
import { pinnedIn } from "../content/style-sheet";
import TangentSim from "../islands/TangentSim";
import { provenanceNotes } from "../provenance/notes";
import { definitionsFor, isLive, schematicModelOf } from "../sims/kinds";
import { inkNets } from "../sims/layout/geometry";
import { layOut } from "../sims/layout/layout";
import { printedDecimals } from "../sims/precision";
import { toStepThrough } from "../sims/step-through";
import { unsupportedStatements } from "../sims/stl/engine";
import { oracleLog } from "../sims/stl/oracle";
import { parseStl } from "../sims/stl/parse";
import { replayOf } from "../sims/stl/view";
import { parseCell } from "../worked/cells";

/**
 * An Agent-built sim where it is used: a Worked example, the Lab or the Tool gallery. A sim an
 * independent recompute checked ships live; one it couldn't check ships as its step-through. Its
 * illustrative constants (assumed, scaled) are labelled above it, derived values below.
 */
interface Props {
  sim: SimRef;
  heading: "h3" | "h4";
}

const { sim: ref, heading: Heading } = Astro.props;
const s = ref.entry.data;
const live = isLive(s) ? s : undefined;
const { inputsHtml, outputsHtml } = provenanceNotes(s.provenance, prose);
/** Rendered prose as plain words, for assistive tech. */
const plainText = (html: string) => html.replace(/<[^>]*>/g, "");

// The sim prints its numbers the way the sheet it opens on does.
const example = s.worked === undefined ? undefined : await getEntry("worked", `${ref.module}/worked/${s.worked}`);
const sheetCells = Object.keys(s.sheet).map((cell) => {
  const { row, col } = parseCell(cell);
  return example?.data.artefact.rows[row]?.[col] ?? "";
});
// A sim on no sheet prints to four places, the sheets' usual precision.
const decimals = printedDecimals(sheetCells) ?? 4;
const math = (tex: string) => prose(`$${tex}$`);
/** A quantity's symbol with its unit, as the Materials write it: `x (mm)`. */
const withUnit = (tex: string, unit: string) => prose(`$${tex}$ (${unit})`);
const label = plainText(prose(s.title));
// The content contract gives every sim it can't recompute a step-through.
const stepThrough = s.stepThrough && toStepThrough(s.stepThrough, prose);
// A schematic is laid out here, at build, exactly as the Drawing gate checked it: the page gets
// the drawing, never the router.
const logic = live?.kind === "logic" ? live : undefined;
const drawing = logic && layOut(logic.model, logic.layout);
const ladder = live?.kind === "ladder" ? live : undefined;
const ladderDrawing = ladder && layOut(schematicModelOf(ladder), ladder.layout);
// An STL listing with an instruction the interpreter lacks plays awlsim's own trace of the example's
// values, from its oracle log in the build records (the stl gate checked the log is current).
const stl = s.kind === "stl" ? s : undefined;
const stlReplay = (() => {
  if (!stl || live) return undefined;
  const path = join(buildContentDir(), "build-records", "oracle", ref.module, `${ref.name}.json`);
  if (!existsSync(path)) throw new Error(`${ref.module}/${ref.name}: no oracle log for its step-through at ${path}`);
  return replayOf(stl.model, oracleLog.parse(JSON.parse(readFileSync(path, "utf8"))), stl.start);
})();
// Astro's props drop a REAL's sign of zero (−0.0 arrives as 0): the island is told which to restore.
const negativeZero = (start: Record<string, number>) =>
  Object.keys(start).filter((operand) => Object.is(start[operand], -0));
const missing =
  stl && !live
    ? unsupportedStatements(parseStl(stl.model.source)).map(({ statement: st }) =>
        [st.op, st.text].filter(Boolean).join(" "),
      )
    : [];
// A control loop's block diagram is laid out the same way, and its step response is read by the
// definitions the Course style sheet pins: a build without them fails, naming the missing one.
const control = live?.kind === "control" ? live : undefined;
const controlDrawing = control && layOut(control.model, control.layout);
const controlDefinitions = control && definitionsFor(control, pinnedIn(buildContentDir()));
---

<article class="sim-card" id={`sim-${ref.module}-${ref.name}`} data-sim-kind={s.kind} data-recompute={s.recompute}>
  <div class="sim-head">
    <span class="field-label">{live ? "Sim" : "Step-through"}</span>
    <Heading
      class="font-print text-sheet-title font-semibold text-graphite [font-variation-settings:'wdth'_87]"
      set:html={prose(s.title)}
    />
    <p class="max-w-[68ch] text-body-small text-muted" set:html={prose(s.caption)} />
  </div>
  {inputsHtml && <div class="mbe-3" set:html={inputsHtml} />}
  {live?.kind === "scl" ? (
    <SclSim
      client:visible
      model={live.model}
      start={live.start}
      negativeZero={negativeZero(live.start)}
      tune={live.tune}
      label={label}
      walkthrough={live.walkthrough.map((w) => ({
        titleHtml: prose(w.title),
        lines: w.lines,
        ...(w.note ? { noteHtml: prose(w.note) } : {}),
        ...(w.fragment ? { fragment: w.fragment } : {}),
      }))}
      divergences={live.divergences.map((d) => ({ line: d.line, examHtml: prose(d.exam), noteHtml: prose(d.note) }))}
    />
  ) : live?.kind === "stl" ? (
    <StlSim
      client:visible
      model={live.model}
      start={live.start}
      negativeZero={negativeZero(live.start)}
      tune={live.tune}
      label={label}
    />
  ) : stl && stlReplay ? (
    <>
      <StlSim client:visible model={stl.model} start={stl.start} tune={stl.tune} label={label} replay={stlReplay} />
      <p class="mbs-2 max-w-[68ch] text-body-small text-muted">
        A step-through, not a live sim: the interpreter doesn't run {[...new Set(missing)].join(", ")} yet, so it plays
        the scans the build's oracle (awlsim) ran on the example's values.
      </p>
    </>
  ) : ladder && ladderDrawing ? (
    <LadderSim
      client:visible
      model={ladder.model}
      drawing={ladderDrawing}
      nets={inkNets(ladderDrawing, ladder.model.nets)}
      start={ladder.start}
      scenario={ladder.scenario}
      cycle={ladder.cycle}
      label={label}
    />
  ) : logic && drawing ? (
    <LogicSim
      client:visible
      model={logic.model}
      drawing={drawing}
      nets={inkNets(drawing, logic.model.nets)}
      start={logic.start}
      label={label}
    />
  ) : live?.kind === "gradient-descent" ? (
    <GradientDescentSim
      client:visible
      model={live.model}
      start={live.start}
      tune={live.tune}
      decimals={decimals}
      label={label}
      mathHtml={{
        k: math("k"),
        theta0: math("\\theta_0"),
        theta1: math("\\theta_1"),
        J: math("J(\\theta)"),
        alpha: math("\\alpha"),
        start: math("\\theta^{(0)}"),
        x: math("x"),
        y: math("y"),
      }}
    />
  ) : live?.kind === "tangent" ? (
    <TangentSim
      client:visible
      model={live.model}
      start={live.start}
      tune={live.tune}
      decimals={decimals}
      label={label}
      mathHtml={{
        a: math("a"),
        h: math("h"),
        x: math("x"),
        y: math("y"),
        f: math("f(x)"),
        fa: math("f(a)"),
        fah: math("f(a + h)"),
        secant: math("\\frac{f(a + h) - f(a)}{h}"),
        slope: math("f'(a)"),
        toZero: math("h \\to 0"),
        p: math("P"),
        q: math("Q"),
      }}
    />
  ) : control && controlDrawing && controlDefinitions ? (
    <ControlSim
      client:visible
      model={{ plant: control.model.plant }}
      drawing={controlDrawing}
      nets={inkNets(controlDrawing, control.model.nets)}
      start={control.start}
      tune={control.tune}
      definitions={controlDefinitions}
      decimals={decimals}
      label={label}
      mathHtml={{
        K: math("K"),
        sigma: math("\\sigma"),
        jw: math("j\\omega"),
        t: withUnit("t", "s"),
        y: math("y(t)"),
        w: withUnit("\\omega", "rad/s"),
        magnitude: withUnit("|KG(j\\omega)|", "dB"),
        phase: withUnit("\\angle KG(j\\omega)", "°"),
        re: math("\\mathrm{Re}"),
        im: math("\\mathrm{Im}"),
        zeta: math("\\zeta"),
        wn: math("\\omega_n"),
        wd: math("\\omega_d"),
        overshoot: prose("overshoot"),
        Tp: math("T_p"),
        Tr: math("T_r"),
        Ts: math("T_s"),
        wc: math("\\omega_c"),
        PM: prose("PM"),
      }}
    />
  ) : live?.kind === "plane-wall" ? (
    <PlaneWallSim
      client:visible
      model={live.model}
      start={live.start}
      tune={live.tune}
      decimals={decimals}
      label={label}
      temperatureUnit={live.units.temperature}
      mathHtml={{
        x: withUnit("x", live.units.length),
        T: withUnit("T", live.units.temperature),
        time: withUnit("t", "s"),
        diffusivity: withUnit("\\alpha", `${live.units.length}²/s`),
        Fo: math("\\mathrm{Fo} = \\frac{\\alpha t}{L^2}"),
      }}
      mapLabels={{
        x: `x (${live.units.length})`,
        t: "t (s)",
        T: `T (${live.units.temperature})`,
      }}
    />
  ) : (
    stepThrough && (
      <>
        <StepThrough client:visible data={stepThrough} label={label} />
        <p class="mbs-2 max-w-[68ch] text-body-small text-muted">
          A step-through, not a live sim: no independent recompute could check a model of this figure, so it steps
          through the Materials' own values.
        </p>
      </>
    )
  )}
  {outputsHtml && <div class="mbs-3" set:html={outputsHtml} />}
</article>
