---
import Cell from "../components/Cell.astro";
import HonestyCell from "../components/HonestyCell.astro";
import Sim from "../components/Sim.astro";
import TitleBlock from "../components/TitleBlock.astro";
import { SIM_KINDS } from "../content/contract";
import { getSims } from "../content/course";
import Sheet from "../layouts/Sheet.astro";

// The Tool gallery: one live sim of every kind the Course has, and one step-through, the page the
// Owner tries on a real phone before every Template release. Linked from no page; the nav marks it
// with the Lab, the other page of tools.
const sims = await getSims();
const shown = [
  ...SIM_KINDS.flatMap((kind) => {
    const first = sims.find((s) => s.entry.data.kind === kind && s.entry.data.recompute === "independent");
    return first ? [first] : [];
  }),
  ...sims.filter((s) => s.entry.data.recompute === "none").slice(0, 1),
];
---

<Sheet title="Tool gallery" nav="lab">
  <TitleBlock class="grid-cols-2 pad:grid-cols-[2.6fr_1fr]">
    <Cell label="Template" class="col-span-2 pad:col-span-1">
      <h1 class="font-print text-title font-bold text-graphite [font-variation-settings:'wdth'_80]">Tool gallery</h1>
    </Cell>
    <Cell label="Tools">
      <span class="font-quantity text-quantity-large font-medium text-graphite tabular-nums">{shown.length}</span>
    </Cell>
    <HonestyCell />
  </TitleBlock>

  {shown.length === 0 && <p class="mbs-8 text-muted">The Course has no sim yet.</p>}
  <div class="mbs-8 space-y-12">
    {shown.map((sim) => (
      <Sim sim={sim} heading="h3" />
    ))}
  </div>
</Sheet>
