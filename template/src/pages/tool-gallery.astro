---
import Cell from "../components/Cell.astro";
import HonestyCell from "../components/HonestyCell.astro";
import Part from "../components/Part.astro";
import PythonTool from "../components/PythonTool.astro";
import Sim from "../components/Sim.astro";
import TitleBlock from "../components/TitleBlock.astro";
import { SIM_KINDS } from "../content/contract";
import { getParts, getPythonTools, getSims } from "../content/course";
import Sheet from "../layouts/Sheet.astro";

// The Tool gallery: one live sim of every kind the Course has (a mechanism: one of each type), one step-through, one Pyodide
// tool and one machine part in its 3D viewer, the page the Owner tries on a real phone before every Template release. The Pyodide tool
// is the timing run: a live run shows how long Python took to start, load and run, and what it
// fetched. Linked from no page; the nav marks it with the Lab, the other page of tools.
const sims = await getSims();
const shown = [
  ...SIM_KINDS.flatMap((kind) => {
    const live = sims.filter((s) => s.entry.data.kind === kind && s.entry.data.recompute === "independent");
    // A mechanism is one kind with two model types, each its own view: the first live one of each, so a
    // phone pass covers the four-bar and the gear pair, not one of them.
    if (kind === "mechanism")
      return ["four-bar", "gear-pair"].flatMap((type) => {
        const first = live.find((s) => s.entry.data.kind === "mechanism" && s.entry.data.model.type === type);
        return first ? [first] : [];
      });
    return live.slice(0, 1);
  }),
  ...sims.filter((s) => s.entry.data.recompute === "none").slice(0, 1),
];
const python = (await getPythonTools()).slice(0, 1);
const parts = (await getParts()).slice(0, 1);
---

<Sheet title="Tool gallery" nav="lab">
  <TitleBlock class="grid-cols-2 pad:grid-cols-[2.6fr_1fr]">
    <Cell label="Template" class="col-span-2 pad:col-span-1">
      <h1 class="font-print text-title font-bold text-graphite [font-variation-settings:'wdth'_80]">Tool gallery</h1>
    </Cell>
    <Cell label="Tools">
      <span class="font-quantity text-quantity-large font-medium text-graphite tabular-nums">
        {shown.length + python.length + parts.length}
      </span>
    </Cell>
    <HonestyCell />
  </TitleBlock>

  {shown.length + python.length + parts.length === 0 && <p class="mbs-8 text-muted">The Course has no tool yet.</p>}
  <div class="mbs-8 space-y-12">
    {shown.map((sim) => (
      <Sim sim={sim} heading="h3" />
    ))}
    {python.map((tool) => (
      <PythonTool tool={tool} heading="h3" timing />
    ))}
    {parts.map((part) => (
      <Part part={part} heading="h3" />
    ))}
  </div>
</Sheet>
