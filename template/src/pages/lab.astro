---
// The Lab: every interactive tool in the Course, by Module, for free play: each Agent-built sim
// beside the Module that uses it (a live sim, or the step-through a sim falls back to), then its
// Pyodide tools, then its machine parts, each in its 3D viewer.
import Cell from "../components/Cell.astro";
import HonestyCell from "../components/HonestyCell.astro";
import ModuleHeading from "../components/ModuleHeading.astro";
import Part from "../components/Part.astro";
import PythonTool from "../components/PythonTool.astro";
import Sim from "../components/Sim.astro";
import TitleBlock from "../components/TitleBlock.astro";
import { getCourse, getModules, getParts, getPythonTools, getSims, prose } from "../content/course";
import Sheet from "../layouts/Sheet.astro";

const course = await getCourse();
const sims = await getSims();
const pythonTools = await getPythonTools();
const parts = await getParts();
const groups = (await getModules())
  .map((module) => ({
    module,
    tools: sims.filter((s) => s.module === module.id),
    python: pythonTools.filter((t) => t.module === module.id),
    parts: parts.filter((p) => p.module === module.id),
  }))
  .filter((g) => g.tools.length + g.python.length + g.parts.length > 0);
---

<Sheet title="Lab" nav="lab">
  <TitleBlock class="grid-cols-2 pad:grid-cols-[2.6fr_1fr]">
    <Cell label="Lab" class="col-span-2 pad:col-span-1">
      <h1
        class="font-print text-title font-bold text-graphite [font-variation-settings:'wdth'_80]"
        set:html={prose(course.name)}
      />
    </Cell>
    <Cell label="Tools">
      <span class="font-quantity text-quantity-large font-medium text-graphite tabular-nums">
        {sims.length + pythonTools.length + parts.length}
      </span>
    </Cell>
    <HonestyCell />
  </TitleBlock>

  {groups.length === 0 ? (
    <>
      <h2 class="group-heading mbs-8 mbe-4">Tools</h2>
      <p class="text-muted">No interactive tools are built for this Course yet.</p>
    </>
  ) : (
    groups.map(({ module, tools, python, parts: moduleParts }) => (
      <section class="hub-module" aria-label={`Module ${module.number}`}>
        <ModuleHeading module={module} />
        <div class="space-y-12">
          {tools.map((sim) => (
            <Sim sim={sim} heading="h3" />
          ))}
          {python.map((tool) => (
            <PythonTool tool={tool} heading="h3" />
          ))}
          {moduleParts.map((part) => (
            <Part part={part} heading="h3" />
          ))}
        </div>
      </section>
    ))
  )}
</Sheet>
