---
import Cell from "../components/Cell.astro";
import HonestyCell from "../components/HonestyCell.astro";
import TitleBlock from "../components/TitleBlock.astro";
import { getCourse, getModules, prose } from "../content/course";
import Sheet from "../layouts/Sheet.astro";

const course = await getCourse();
const modules = await getModules();
---

<Sheet title="Contents">
  <TitleBlock class="grid-cols-2 pad:grid-cols-[2.6fr_1fr_1fr]">
    <Cell label="Course" class="col-span-2 pad:col-span-1">
      <h1
        class="font-print text-display-phone font-bold tracking-[-0.01em] text-graphite [font-variation-settings:'wdth'_75] pad:text-display"
        set:html={prose(course.name)}
      />
    </Cell>
    <Cell label="Code">
      <span class="font-quantity text-quantity text-graphite" set:html={prose(course.code)} />
    </Cell>
    <Cell label="Modules">
      <span class="font-quantity text-quantity-large font-medium text-graphite tabular-nums">{modules.length}</span>
    </Cell>
    <HonestyCell />
  </TitleBlock>

  <h2 class="group-heading mbs-8">Modules</h2>
  <ol>
    {modules.map((m) => (
      <li>
        <a
          href={`/${m.id}/`}
          class="group grid grid-cols-[44px_1fr] items-center gap-4 border-be border-pencil/50 pbs-3 pbe-3 hover:bg-print/8"
        >
          <span class="grid size-11 place-items-center border-[1.5px] border-print font-print text-caption font-bold text-print">
            {m.number}
          </span>
          <span>
            <span
              class="block text-contents-title font-semibold group-hover:underline"
              set:html={prose(m.entry.data.title)}
            />
            <span class="block text-body-small text-muted" set:html={prose(m.entry.data.summary)} />
          </span>
        </a>
      </li>
    ))}
  </ol>
</Sheet>
