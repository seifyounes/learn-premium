---
import { render } from "astro:content";
import Cell from "../components/Cell.astro";
import HonestyCell from "../components/HonestyCell.astro";
import SolvingTable from "../components/SolvingTable.astro";
import TitleBlock from "../components/TitleBlock.astro";
import { getModules, moduleEntries, prose, type ModuleRef } from "../content/course";
import RevealAnswer from "../islands/RevealAnswer";
import Sheet from "../layouts/Sheet.astro";

export async function getStaticPaths() {
  const modules = await getModules();
  return modules.map((m) => ({ params: { module: m.id }, props: { module: m } }));
}

interface Props {
  module: ModuleRef;
}

const { module } = Astro.props;
const beats = await Promise.all(
  (await moduleEntries("beats", module.id)).map(async (b) => ({ beat: b, Content: (await render(b)).Content })),
);
const worked = await moduleEntries("worked", module.id);
const practice = await moduleEntries("practice", module.id);
---

<Sheet title={module.entry.data.title}>
  <TitleBlock class="grid-cols-[auto_auto_1fr]">
    <a href="/" class="label-action flex items-center gap-2 bg-sheet px-3 hover:bg-print/10">
      <svg viewBox="0 0 16 16" class="size-4 rtl:-scale-x-100" aria-hidden="true">
        <path
          d="M10 3 5 8l5 5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>
      </svg>
      Back
    </a>
    <Cell label="Module">
      <span class="font-quantity text-quantity-large font-medium text-graphite">{module.number}</span>
    </Cell>
    <Cell label="Title">
      <h1
        class="font-print text-title font-bold text-graphite [font-variation-settings:'wdth'_80]"
        set:html={prose(module.entry.data.title)}
      />
    </Cell>
    <HonestyCell />
  </TitleBlock>

  <section aria-labelledby="summary">
    <h2 id="summary" class="group-heading mbs-10 mbe-4">
      Summary
    </h2>
    {beats.map(({ beat, Content }) => (
      <article class="mbe-6 max-w-[68ch]">
        <h3
          class="mbe-2 font-print text-sheet-title font-semibold [font-variation-settings:'wdth'_87]"
          set:html={prose(beat.data.title)}
        />
        <div class="space-y-3">
          <Content />
        </div>
      </article>
    ))}
  </section>

  <section aria-labelledby="worked">
    <h2 id="worked" class="group-heading mbs-10 mbe-4">
      Worked examples
    </h2>
    {worked.map(({ data: w }) => (
      <article class="mbe-8 space-y-4">
        <TitleBlock class="grid-cols-[1fr_auto]">
          <Cell label="Title">
            <h3
              class="font-print text-sheet-title-phone font-semibold text-graphite [font-variation-settings:'wdth'_87] pad:text-sheet-title"
              set:html={prose(w.title)}
            />
          </Cell>
          <Cell label="Example">
            <span class="font-quantity text-quantity text-graphite" set:html={prose(w.code)} />
          </Cell>
        </TitleBlock>
        <div class="max-w-[68ch] border-[1.2px] border-pencil bg-sheet px-4 pbs-3 pbe-3">
          <span class="field-label block mbe-1">Given</span>
          <p set:html={prose(w.statement)} />
        </div>
        <SolvingTable table={w.table} />
        <div class="answer-frame m-1 inline-block bg-sheet px-3.5 pbs-[7px] pbe-[9px]">
          <span class="field-label block mbe-1">Answer</span>
          <p class="font-semibold text-graphite" set:html={prose(w.answer)} />
        </div>
      </article>
    ))}
  </section>

  <section aria-labelledby="practice">
    <h2 id="practice" class="group-heading mbs-10 mbe-4">
      Practice
    </h2>
    {practice.map(({ data: p }, i) => (
      <article class="mbe-6 max-w-[68ch] space-y-3">
        <p>
          <span class="font-quantity text-graphite">{i + 1}.</span> <Fragment set:html={prose(p.question)} />
        </p>
        <RevealAnswer client:visible modelHtml={prose(p.model)} answer={p.answer} unitHtml={prose(p.answer.unit)} />
      </article>
    ))}
  </section>
</Sheet>
