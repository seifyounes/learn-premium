---
import BackCell from "../components/BackCell.astro";
import Cell from "../components/Cell.astro";
import GivenBox from "../components/GivenBox.astro";
import HonestyCell from "../components/HonestyCell.astro";
import Infographic from "../components/Infographic.astro";
import SectionRail from "../components/SectionRail.astro";
import PythonTool from "../components/PythonTool.astro";
import Sim from "../components/Sim.astro";
import SummaryBeat from "../components/SummaryBeat.astro";
import TitleBlock from "../components/TitleBlock.astro";
import Watch from "../components/Watch.astro";
import { arabicProse } from "../arabic/notes";
import {
  getCourse,
  getMedia,
  getModules,
  getPythonTools,
  getSims,
  itemNumber,
  moduleEntries,
  prose,
  type ModuleRef,
} from "../content/course";
import PracticeItem from "../islands/PracticeItem";
import WorkedSheet from "../islands/WorkedSheet";
import Sheet from "../layouts/Sheet.astro";
import { practiceAnchor, workedAnchor, type PageShape, type Section } from "../progress/progress";
import { provenanceNotes } from "../provenance/notes";
import { toSheet } from "../worked/sheet";

export async function getStaticPaths() {
  const modules = await getModules();
  return modules.map((m) => ({ params: { module: m.id }, props: { module: m } }));
}

interface Props {
  module: ModuleRef;
}

const { module } = Astro.props;
const course = await getCourse();
const media = await getMedia(module.id);
const beats = await moduleEntries("beats", module.id);
const worked = await moduleEntries("worked", module.id);
const practice = await moduleEntries("practice", module.id);
/** The sims each Worked example carries inline, opened on its values. */
const sims = (await getSims()).filter((s) => s.module === module.id);
const simsOf = (id: string) => sims.filter((s) => s.entry.data.worked === itemNumber(id));
/** The Pyodide tools each Worked example carries, below its sims. */
const pythonTools = (await getPythonTools()).filter((t) => t.module === module.id);
const pythonOf = (id: string) => pythonTools.filter((t) => t.entry.data.worked === itemNumber(id));
// A tool naming a Worked example the Module doesn't have would drop off this page unseen.
for (const tool of pythonTools) {
  const number = tool.entry.data.worked;
  if (number !== undefined && !worked.some((w) => itemNumber(w.id) === number))
    throw new Error(
      `${tool.entry.filePath ?? tool.entry.id}: names Worked example ${number}, which Module ${module.id} doesn't have`,
    );
}

// Watch → Summary → Worked examples → Practice; a section with nothing in it isn't on the page.
const has: Record<Section, boolean> = {
  watch: media.video !== undefined || media.audio !== undefined || media.youtube.length > 0,
  summary: media.infographic !== undefined || beats.length > 0,
  worked: worked.length > 0,
  practice: practice.length > 0,
};
const SECTION_NAMES: { id: Section; label: string; short: string }[] = [
  { id: "watch", label: "Watch", short: "Watch" },
  { id: "summary", label: "Summary", short: "Summary" },
  { id: "worked", label: "Worked examples", short: "Worked" },
  { id: "practice", label: "Practice", short: "Practice" },
];
const sections = SECTION_NAMES.filter((s) => has[s.id]);
const shape: PageShape = { worked: worked.map((w) => w.data.code), practice: practice.map((p) => itemNumber(p.id)) };
const notes = (p: Parameters<typeof provenanceNotes>[0]) => provenanceNotes(p, prose);
---

<Sheet title={module.entry.data.title} nav="modules">
  <TitleBlock class="grid-cols-[auto_auto_1fr]">
    <BackCell />
    <Cell label="Module">
      <span class="font-quantity text-quantity-large font-medium text-graphite">{module.number}</span>
    </Cell>
    <Cell label="Title">
      <h1
        class="font-print text-title font-bold text-graphite [font-variation-settings:'wdth'_80]"
        set:html={prose(module.entry.data.title)}
      />
    </Cell>
    <HonestyCell />
  </TitleBlock>

  <div class="module-page" data-module-page data-module={module.id} data-shape={JSON.stringify(shape)}>
    <SectionRail sections={sections} />

    <div class="module-sections">
      {has.watch && (
        <section id="watch" class="module-section" aria-labelledby="watch-heading">
          <h2 id="watch-heading" class="group-heading mbe-4">
            Watch
          </h2>
          <Watch media={media} />
        </section>
      )}

      {has.summary && (
        <section id="summary" class="module-section" aria-labelledby="summary-heading">
          <h2 id="summary-heading" class="group-heading mbe-4">
            Summary
          </h2>
          {media.infographic && <Infographic infographic={media.infographic} />}
          {beats.map((beat, i) => (
            <SummaryBeat beat={beat} figureId={`beat-${i + 1}-figure`} />
          ))}
          <div data-summary-end />
        </section>
      )}

      {has.worked && (
        <section id="worked" class="module-section" aria-labelledby="worked-heading">
          <h2 id="worked-heading" class="group-heading mbe-4">
            Worked examples
          </h2>
          {worked.map(({ id, data: w }) => {
            const { inputsHtml, outputsHtml } = notes(w.provenance);
            return (
              <article id={workedAnchor(w.code)} class="worked-example" data-artefact={w.artefact.kind}>
                <WorkedSheet
                  client:visible
                  sheet={toSheet(w, prose, course.arabicNotes ? arabicProse : undefined)}
                  topicHtml={prose(module.entry.data.title)}
                  module={module.id}
                  outputsHtml={outputsHtml}
                >
                  <GivenBox statement={w.statement} given={w.given} inputsHtml={inputsHtml} />
                </WorkedSheet>
                {simsOf(id).map((sim) => (
                  <Sim sim={sim} heading="h4" />
                ))}
                {pythonOf(id).map((tool) => (
                  <PythonTool tool={tool} heading="h4" />
                ))}
              </article>
            );
          })}
        </section>
      )}

      {has.practice && (
        <section id="practice" class="module-section" aria-labelledby="practice-heading">
          <h2 id="practice-heading" class="group-heading mbe-4">
            Practice
          </h2>
          {practice.map(({ id, data: p }, i) => {
            const { inputsHtml, outputsHtml } = notes(p.provenance);
            const item = itemNumber(id);
            const common = { module: module.id, item, modelHtml: prose(p.model), outputsHtml };
            return (
              <article id={practiceAnchor(item)} class="practice-item" data-kind={p.kind}>
                <p>
                  <span class="font-quantity text-graphite">{i + 1}.</span> <Fragment set:html={prose(p.question)} />
                </p>
                {inputsHtml && <div set:html={inputsHtml} />}
                {p.kind === "numeric" ? (
                  <PracticeItem
                    client:visible
                    {...common}
                    kind="numeric"
                    answer={{ value: p.answer.value, tolerance: p.answer.tolerance }}
                    {...(p.answer.unit === undefined ? {} : { unitHtml: prose(p.answer.unit) })}
                  />
                ) : (
                  <PracticeItem client:visible {...common} kind="prose" earnsHtml={p.earns.map(prose)} />
                )}
              </article>
            );
          })}
        </section>
      )}
    </div>
  </div>
</Sheet>

<script>
  import "../progress/module-page.ts";
</script>
