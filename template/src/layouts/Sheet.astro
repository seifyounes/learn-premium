---
import "@fontsource-variable/archivo/wdth.css";
import "@fontsource/atkinson-hyperlegible-next/latin-400.css";
import "@fontsource/atkinson-hyperlegible-next/latin-600.css";
import "@fontsource/atkinson-hyperlegible-mono/latin-400.css";
import "@fontsource/atkinson-hyperlegible-mono/latin-500.css";
import "katex/dist/katex.min.css";
import "../styles/global.css";
import { getCourse } from "../content/course";

interface Props {
  title: string;
}

const { title } = Astro.props;
const course = await getCourse();
---

<!doctype html>
<html lang="en" dir="ltr" data-pad={course.pad}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · {course.name}</title>
  </head>
  <body class="min-h-dvh sm:px-6 sm:py-6">
    <main class="sheet mx-auto max-w-[1200px] px-4 pbs-4 pbe-5 sm:rounded-sheet sm:px-10 sm:pbs-7 sm:pbe-6">
      <slot />
      <footer class="mbs-12 border-bs border-print pbs-3 text-body-small text-muted">
        {course.credit.professor} · {course.credit.course} · {course.credit.university}
      </footer>
    </main>
  </body>
</html>
